FROM enterprise_rag_base

USER root

COPY requirements.txt ./
RUN python -m pip install --no-cache-dir --requirement requirements.txt

COPY ./app ./app

USER appuser
WORKDIR /app

ENTRYPOINT ["/usr/bin/dumb-init", "--"]

CMD ["granian", "--interface", "asgi", "--host", "0.0.0.0", "--port", "8082", "app.main:app"]
